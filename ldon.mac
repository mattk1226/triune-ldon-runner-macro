    /if (${route.Equal[gfaydark_to_lfaydark]}) {
        /varset RZone    gfaydark
        /varset RZoned   1
        /varset RHeading 169.77
        /varset RLastZ   3.75
        /varset RCount   6
        /varset RP[1] -2475.47 -983.32
        /varset RP[2] -2508.90 -1011.15
        /varset RP[3] -2544.38 -1033.92
        /varset RP[4] -2577.02 -1061.64
        /varset RP[5] -2595.93 -1098.98
        /varset RP[6] -2626.51 -1109.55
        /varset RBuiltIn TRUE
        /return
    }
/return

| ---------------------------------------------------------
| Travel one recorded route
Sub RunRoute(string route)
    /declare startZone int   local ${Zone.ID}
    /declare i         int   local 1
    /declare wy        float local 0
    /declare wx        float local 0
    /declare t         timer local 0

    /call LoadRoute ${route}
    /if (${RCount}<2) {
        /echo Zone crossing [${route}] is not built in (see Sub BuiltInRoute). Ending.
        /endmacro
    }
    /if (${RZone.NotEqual[${Zone.ShortName}]}) {
        /echo Route [${route}] starts in ${RZone} but I'm in ${Zone.ShortName}. Ending.
        /endmacro
    }
    /if (${RBuiltIn} && !${Navigation.MeshLoaded}) {
        /echo Route [${route}] needs a navmesh for ${Zone.ShortName}, and none is loaded. Ending.
        /endmacro
    }
    /echo Running route [${route}]

    | With a mesh, nav to the recorded zone line. If nav can't path to the
    | very last point (it is often just off the mesh), fall back to an
    | earlier recorded point and walk the rest.
    /if (${RZoned} && ${Navigation.MeshLoaded}) {
        /varset i ${RCount}
        :trynav
        /varset wy ${RP[${i}].Arg[1]}
        /varset wx ${RP[${i}].Arg[2]}
        /if (${i}==${RCount} && ${RLastZ.NotEqual[NONE]}) {
            /nav locyxz ${wy} ${wx} ${RLastZ}
        } else {
            /nav locyx ${wy} ${wx}
        }
        /delay 2s
        /if (!${Navigation.Active} && ${Zone.ID}==${startZone} && ${Math.Distance[${wy},${wx}]}>40) {
            /varcalc i ${i}-1
            /if (${i}>=1 && ${i}>=${RCount}-10) /goto :trynav
            /echo Nav can't path to the end of route [${route}]. Re-record it, or check this zone's mesh. Ending.
            /endmacro
        }
        /if (${i}<${RCount}) /echo Nav is using point ${i} of ${RCount}, walking the rest.
        /delay 15m (!${Navigation.Active} || ${Zone.ID}!=${startZone})
        /if (${Zone.ID}!=${startZone}) /goto :arrived
        /if (${Math.Distance[${wy},${wx}]}>40) {
            /echo Nav stopped before reaching the zone line for [${route}]. Ending.
            /endmacro
        }
        /varcalc i ${i}+1
        /if (${i}>${RCount}) /goto :cross
    }

    :nextpoint
        /varset wy ${RP[${i}].Arg[1]}
        /varset wx ${RP[${i}].Arg[2]}
        /moveto loc ${wy} ${wx}
        /varset t 30s
        :wait
            /if (${Zone.ID}!=${startZone}) /goto :arrived
            /delay 1
        /if (${Math.Distance[${wy},${wx}]}>12 && ${t}) /goto :wait
        /if (${Math.Distance[${wy},${wx}]}>12) {
            /moveto off
            /echo Stuck on route [${route}] at point ${i}. Ending.
            /endmacro
        }
        /varcalc i ${i}+1
    /if (${i}<=${RCount}) /goto :nextpoint

    :cross
    /moveto off
    /if (${RZoned}) {
        | keep running the way you were facing until the zone line takes us
        /face fast heading ${RHeading}
        /keypress forward hold
        /delay 20s ${Zone.ID}!=${startZone}
        /keypress forward
        /if (${Zone.ID}==${startZone}) {
            /echo Route [${route}] finished but I didn't zone. Ending.
            /endmacro
        }
    }
    :arrived
    /if (${RZoned}) /delay 5s
/return

| ---------------------------------------------------------
Sub GetAdventure
    /declare npcID int    local ${Spawn[npc ${QuestNPC}].ID}
    /declare i     int    local 1
    /declare nm    string local
    /declare tries int    local 0
    /if (!${npcID}) {
        /echo Can't find ${QuestNPC}. Ending.
        /endmacro
    }
    /if (${HasCampSpot}) {
        | come in through the clear spot, then walk straight to the NPC
        /if (${Spawn[id ${npcID}].Distance}>80 && ${Navigation.MeshLoaded}) {
            /nav locyxz ${CampY} ${CampX} ${CampZ}
            /delay 1s
            /delay 5m !${Navigation.Active}
        }
        /moveto id ${npcID}
        /delay 1s
        /delay 30s ${MoveTo.Stopped}
    } else {
        /if (${Spawn[id ${npcID}].Distance}>15) {
            /nav id ${npcID}
            /delay 1s
            /delay 5m !${Navigation.Active}
        }
    }
    /if (${Spawn[id ${npcID}].Distance}>30) {
        /echo Couldn't get to ${QuestNPC}. Ending.
        /endmacro
    }
    /target id ${npcID}
    /delay 2s ${Target.ID}==${npcID}
    /face fast

    /click right target
    /delay 5s ${Window[AdventureRequestWnd].Open}
    /if (!${Window[AdventureRequestWnd].Open}) {
        /echo Adventure window didn't open. Ending.
        /endmacro
    }
    /notify AdventureRequestWnd AdvRqst_RiskCombobox listselect ${RiskIndex}
    /delay 5
    /notify AdventureRequestWnd AdvRqst_TypeCombobox listselect ${TypeIndex}
    /delay 5
    | The Accept button only lights up when the server offers an adventure.
    | On an error (already have one, not eligible, ...) the server puts the
    | reason in the window text and Accept stays greyed out, so retry a couple
    | of times and then stop instead of travelling without an adventure.
    :request
    /varcalc tries ${tries}+1
    /notify AdventureRequestWnd AdvRqst_RequestButton leftmouseup
    /delay 10s ${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}
    /if (!${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}) {
        /echo Adventure request ${tries} of 3 was refused: ${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text}
        /if (${tries}<3) {
            /delay 5s
            /goto :request
        }
        /echo Couldn't get an adventure from ${QuestNPC}. If you already have one, start with skip. Ending.
        /endmacro
    }
    /delay 5

    | Which entrance does this adventure use?
    /varset UseEnt2 FALSE
    /if (${Ent2Names.NotEqual[none]}) {
        :names
        /varset nm ${Ent2Names.Arg[${i},|]}
        /if (${nm.Length} && ${nm.NotEqual[NULL]}) {
            /if (${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text.Find[${nm}]}) /varset UseEnt2 TRUE
            /varcalc i ${i}+1
            /goto :names
        }
    }
    /if (${UseEnt2}) /echo This adventure uses the second entrance.

    | Accept, and check it took: the button greys out (or the window closes)
    | once the adventure is ours
    /varset tries 0
    :accept
    /varcalc tries ${tries}+1
    /notify AdventureRequestWnd AdvRqst_AcceptButton leftmouseup
    /delay 5s (!${Window[AdventureRequestWnd].Open} || !${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled})
    /if (${Window[AdventureRequestWnd].Open} && ${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}) {
        /if (${tries}<2) /goto :accept
        /echo Accepted the adventure but the window didn't confirm it: ${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text} Ending.
        /endmacro
    }
    /echo Adventure accepted.
    /delay 2s
/return

| ---------------------------------------------------------
| From the landing zone back to the camp: run the return path, then use
| the Magus if this camp's trip back needs one
Sub ReturnToCamp
    /call TravelPath ${ReturnPath}
    /if (${RetMagusSay.NotEqual[none]} && ${Zone.ShortName.NotEqual[${CampZone}]}) /call UseMagus ret
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /echo Couldn't get back to ${CampZone} (I'm in ${Zone.ShortName}). Ending.
        /endmacro
    }
/return

| ---------------------------------------------------------
| Port by talking to a Magus
| which = out (camp -> entrance zone) or ret (landing zone -> camp)
Sub UseMagus(string which)
    /declare phrase    string local ${MagusSay}
    /declare mname     string local ${MagusName}
    /declare doExit    bool   local ${HasMagusExit}
    /declare exitY     float  local ${MagusExitY}
    /declare exitX     float  local ${MagusExitX}
    /if (${which.Equal[ret]}) {
        /varset phrase ${RetMagusSay}
        /varset mname  ${RetMagusName}
        /varset doExit ${HasRetExit}
        /varset exitY  ${RetExitY}
        /varset exitX  ${RetExitX}
    }
    /declare mid       int    local ${NearestSpawn[npc ${mname}].ID}
    /declare startZone string local ${Zone.ShortName}
    /declare t         timer  local 0
    | if the named Magus isn't here, use whichever Magus is closest
    /if (!${mid}) /varset mid ${NearestSpawn[npc Magus].ID}
    /if (!${mid}) {
        /echo No Magus found in ${Zone.ShortName}.
        /return
    }
    /if (${Spawn[id ${mid}].Distance}>15) {
        /nav id ${mid}
        /delay 1s
        /delay 3m !${Navigation.Active}
    }
    /target id ${mid}
    /delay 2s ${Target.ID}==${mid}
    /face fast
    /delay 5
    /say ${phrase}
    /delay 30s ${Zone.ShortName.NotEqual[${startZone}]}
    /delay 5s
    /if (${Zone.ShortName.Equal[${startZone}]}) {
        /echo The Magus didn't port me.
        /return
    }
    | walk straight out of the arrival camp before nav takes over
    /if (${doExit}) {
        /varset t 30s
        /moveto loc ${exitY} ${exitX}
        :wait
            /delay 2
        /if (${Math.Distance[${exitY},${exitX}]}>15 && ${t}) /goto :wait
        /moveto off
        /if (${Math.Distance[${exitY},${exitX}]}>15) /echo Didn't reach the clear spot after the port, carrying on from here.
    }
/return

| ---------------------------------------------------------
| Walk straight from the NPC to the clear spot outside the camp
Sub LeaveCamp
    /declare t timer local 30s
    /moveto loc ${CampY} ${CampX}
    :wait
        /delay 2
    /if (${Math.Distance[${CampY},${CampX}]}>15 && ${t}) /goto :wait
    /moveto off
    /if (${Math.Distance[${CampY},${CampX}]}>15) {
        /echo Couldn't reach the spot outside the camp. Ending.
        /endmacro
    }
/return

| ---------------------------------------------------------
Sub EnterDungeon
    /declare startZone string local ${Zone.ShortName}
    /declare tries     int    local 0
    /declare ez        string local ${Ent1Zone}
    /declare ey        float  local ${Ent1Y}
    /declare ex        float  local ${Ent1X}
    /declare ezz       string local ${Ent1Z}
    /declare edoor     int    local ${Ent1Door}
    /if (${UseEnt2}) {
        /varset edoor ${Ent2Door}
        /varset ez  ${Ent2Zone}
        /varset ey  ${Ent2Y}
        /varset ex  ${Ent2X}
        /varset ezz ${Ent2Z}
    }

    /if (${Zone.ShortName.NotEqual[${ez}]}) {
        /echo The entrance is in ${ez} but I'm in ${Zone.ShortName}. Ending.
        /endmacro
    }
    /if (!${Navigation.MeshLoaded}) {
        /echo No navmesh for ${Zone.ShortName}, can't get to the entrance. Ending.
        /endmacro
    }
    /if (${ezz.Equal[none]}) {
        /nav locyx ${ey} ${ex}
    } else {
        /nav locyxz ${ey} ${ex} ${ezz}
    }
    /delay 1s
    /delay 10m !${Navigation.Active}
    /if (${Math.Distance[${ey},${ex}]}>40) {
        /echo Couldn't reach the dungeon entrance. Ending.
        /endmacro
    }

    :clickloop
        | use the entrance's switch ID if the camp gives one, otherwise the nearest switch
        /if (${edoor}) {
            /doortarget id ${edoor}
        } else {
            /doortarget
        }
        /delay 5
        | walk up to the switch if it's out of click range
        /if (${DoorTarget.Distance}>15) {
            /moveto loc ${DoorTarget.Y} ${DoorTarget.X}
            /delay 10s ${DoorTarget.Distance}<15
            /moveto off
        }
        /face fast door
        /delay 3
        /click left door
        /delay 20s ${Zone.ShortName.NotEqual[${startZone}]}
        /varcalc tries ${tries}+1
    /if (${Zone.ShortName.Equal[${startZone}]} && ${tries}<3) /goto :clickloop

    /if (${Zone.ShortName.Equal[${startZone}]}) {
        /echo Couldn't enter the dungeon. Ending.
        /endmacro
    }
    /delay 5s
/return

| ---------------------------------------------------------
Sub ClearDungeon
    /declare clearTimer timer local ${MaxClearTime}
    /declare calm       int   local 0
    /declare fightTimer timer local 0
    /varset AdvWon FALSE
    /docommand ${PullerModeCmd}
    /delay 1s
    /docommand ${PullerOnCmd}

    :clearloop
        /doevents
        /delay 1s
    /if (!${AdvWon} && ${clearTimer}) /goto :clearloop

    /if (!${AdvWon}) /echo Timed out without a win message, leaving anyway.

    | stop pulling, but keep fighting whatever is still on me
    /docommand ${PullerManualCmd}

    | wait until I've been out of combat for 5 seconds straight
    /varset fightTimer 10m
    :fightloop
        /if (${Me.CombatState.Equal[COMBAT]}) {
            /varset calm 0
        } else {
            /varcalc calm ${calm}+1
        }
        /delay 1s
    /if (${calm}<5 && ${fightTimer}) /goto :fightloop
    /if (${calm}<5) {
        /echo Still in combat 10 minutes after the adventure ended. Ending here so I don't port out mid-fight.
        /endmacro
    }

    /docommand ${PullerOffCmd}
    /delay 2s
/return

| ---------------------------------------------------------
Sub LeaveDungeon
    /declare startZone string local ${Zone.ShortName}

    | Bazaar AA
    /delay 3m ${Me.AltAbilityReady[${BazaarAAID}]}
    /alt activate ${BazaarAAID}
    /delay 60s (${Zone.ShortName.Equal[bazaar]} || ${Zone.ShortName.Equal[${LandZone}]})
    /delay 5s
    | Bazaar and Back can be set to East Commonlands; if it already put us in
    | this camp's landing zone, skip the walk to the map
    /if (${Zone.ShortName.Equal[${LandZone}]}) {
        /echo Bazaar and Back put me in ${LandZone}, skipping the map.
        /return
    }
    /if (${Zone.ShortName.NotEqual[bazaar]}) {
        /echo Bazaar and Back didn't take me to the Bazaar or ${LandZone}. Ending.
        /endmacro
    }
    /call MapPort
/return

| ---------------------------------------------------------
| In the Bazaar: walk to the map and port to this camp's waypoint
Sub MapPort
    /declare row   int local 0
    /declare tries int local 0

    | Walk to the map. The landing spot is random, so try nav, and if it
    | can't start from here, step toward the map and try again.
    :mapwalk
    /if (${Math.Distance[${MapY},${MapX}]}>15 && ${tries}<15) {
        /varcalc tries ${tries}+1
        /if (${Navigation.MeshLoaded}) {
            /nav locyxz ${MapY} ${MapX} ${MapZ}
            /delay 1s
            /if (${Navigation.Active}) {
                /delay 3m !${Navigation.Active}
                /goto :mapwalk
            }
        }
        /moveto loc ${MapY} ${MapX}
        /delay 4s ${Math.Distance[${MapY},${MapX}]}<15
        /moveto off
        /goto :mapwalk
    }
    /if (${Math.Distance[${MapY},${MapX}]}>25) {
        /echo Couldn't get to the map from here. Ending.
        /endmacro
    }

    | Click the map and pick this camp's waypoint
    /doortarget id ${MapSwitchID}
    /delay 5
    /face fast door
    /click left door
    /delay 5s ${Window[WaypointsWnd].Open}
    /if (!${Window[WaypointsWnd].Open}) {
        /echo The map window didn't open. Ending.
        /endmacro
    }
    /notify WaypointsWnd ContinentsList listselect ${MapContinent}
    /delay 1s
    | a camp can give the row number directly; otherwise look the waypoint up by name
    /if (${MapRow}) {
        /varset row ${MapRow}
    } else {
        /varset row ${Window[WaypointsWnd].Child[WaypointsList].List[=${MapWaypoint}]}
    }
    /if (!${row}) {
        /echo Couldn't find ${MapWaypoint} in the waypoint list. Ending.
        /endmacro
    }
    /notify WaypointsWnd WaypointsList listselect ${row}
    /delay 5
    /notify WaypointsWnd SelectedWaypointButton leftmouseup
    /delay 2s
    | answer a confirmation box if one pops up
    /if (${Window[ConfirmationDialogBox].Open}) /notify ConfirmationDialogBox Yes_Button leftmouseup
    /if (${Window[LargeDialogWindow].Open}) /notify LargeDialogWindow LDW_YesButton leftmouseup
    /delay 60s ${Zone.ShortName.Equal[${LandZone}]}
    /delay 5s

    /if (${Zone.ShortName.NotEqual[${LandZone}]}) {
        /echo Expected to land in ${LandZone} but I'm in ${Zone.ShortName}. Ending.
        /endmacro
    }
/return

| ---------------------------------------------------------
Sub Event_AdvWon
    /varset AdvWon TRUE
/return

Sub Event_Slain
    /echo Died on run #${Runs}. Ending.
    /endmacro
/return
