        /varset RLastZ   3.75
        /varset RCount   3
        /varset RP[1] -94.77 8.86
        /varset RP[2] -108.73 46.68
        /varset RP[3] -135.05 55.18
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[innothule_to_sro]}) {
        /varset RZone    innothule
        /varset RZoned   1
        /varset RHeading 321.73
        /varset RLastZ   -23.77
        /varset RCount   6
        /varset RP[1] 2425.42 1012.50
        /varset RP[2] 2450.89 1047.76
        /varset RP[3] 2475.87 1082.32
        /varset RP[4] 2501.13 1118.18
        /varset RP[5] 2524.97 1152.06
        /varset RP[6] 2567.59 1137.51
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[kaladima_to_butcher]}) {
        /varset RZone    kaladima
        /varset RZoned   1
        /varset RHeading 170.86
        /varset RLastZ   3.75
        /varset RCount   6
        /varset RP[1] 101.04 9.52
        /varset RP[2] 58.81 6.92
        /varset RP[3] 15.22 4.23
        /varset RP[4] -27.14 1.63
        /varset RP[5] -51.81 35.02
        /varset RP[6] -76.47 46.18
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[butcher_to_gfaydark]}) {
        /varset RZone    butcher
        /varset RZoned   1
        /varset RHeading 246.08
        /varset RLastZ   3.75
        /varset RCount   6
        /varset RP[1] -1151.15 -3056.88
        /varset RP[2] -1183.39 -3083.84
        /varset RP[3] -1225.25 -3082.91
        /varset RP[4] -1262.50 -3063.90
        /varset RP[5] -1305.25 -3065.52
        /varset RP[6] -1325.96 -3082.54
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[ecommons_to_nro]}) {
        /varset RZone    ecommons
        /varset RZoned   1
        /varset RHeading 261.66
        /varset RLastZ   3.75
        /varset RCount   6
        /varset RP[1] -2366.93 34.29
        /varset RP[2] -2390.62 -0.83
        /varset RP[3] -2413.88 -38.29
        /varset RP[4] -2429.27 -77.48
        /varset RP[5] -2439.50 -119.63
        /varset RP[6] -2446.03 -155.41
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[nro_to_oasis]}) {
        /varset RZone    nro
        /varset RZoned   1
        /varset RHeading 185.99
        /varset RLastZ   31.54
        /varset RCount   5
        /varset RP[1] -1737.07 974.34
        /varset RP[2] -1781.35 965.01
        /varset RP[3] -1821.81 958.58
        /varset RP[4] -1864.33 954.29
        /varset RP[5] -1886.70 952.09
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[oasis_to_sro]}) {
        /varset RZone    oasis
        /varset RZoned   1
        /varset RHeading 178.72
        /varset RLastZ   6.15
        /varset RCount   2
        /varset RP[1] -1895.63 201.02
