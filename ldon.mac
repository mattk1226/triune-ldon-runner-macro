| ---------------------------------------------------------
| Travel one recorded route
Sub RunRoute(string route)
    /declare startZone int   local ${Zone.ID}
    /declare i         int   local 1
    /declare wy        float local 0
    /declare wx        float local 0
    /declare t         timer local 0

    /call LoadRoute ${route}
    /if (${RCount}<2) {
        /echo Zone crossing [${route}] is not built in (see Sub BuiltInRoute). Ending.
        /endmacro
    }
    /if (${RZone.NotEqual[${Zone.ShortName}]}) {
        /echo Route [${route}] starts in ${RZone} but I'm in ${Zone.ShortName}. Ending.
        /endmacro
    }
    /if (${RBuiltIn} && !${Navigation.MeshLoaded}) {
        /echo Route [${route}] needs a navmesh for ${Zone.ShortName}, and none is loaded. Ending.
        /endmacro
    }
    /echo Running route [${route}]

    | With a mesh, nav to the recorded zone line. If nav can't path to the
    | very last point (it is often just off the mesh), fall back to an
    | earlier recorded point and walk the rest.
    /if (${RZoned} && ${Navigation.MeshLoaded}) {
        /varset i ${RCount}
        :trynav
        /varset wy ${RP[${i}].Arg[1]}
        /varset wx ${RP[${i}].Arg[2]}
        /if (${i}==${RCount} && ${RLastZ.NotEqual[NONE]}) {
            /nav locyxz ${wy} ${wx} ${RLastZ}
        } else {
            /nav locyx ${wy} ${wx}
        }
        /delay 2s
        /if (!${Navigation.Active} && ${Zone.ID}==${startZone} && ${Math.Distance[${wy},${wx}]}>40) {
            /varcalc i ${i}-1
            /if (${i}>=1 && ${i}>=${RCount}-10) /goto :trynav
            /echo Nav can't path to the end of route [${route}]. Re-record it, or check this zone's mesh. Ending.
            /endmacro
        }
        /if (${i}<${RCount}) /echo Nav is using point ${i} of ${RCount}, walking the rest.
        /delay 15m (!${Navigation.Active} || ${Zone.ID}!=${startZone})
        /if (${Zone.ID}!=${startZone}) /goto :arrived
        /if (${Math.Distance[${wy},${wx}]}>40) {
            /echo Nav stopped before reaching the zone line for [${route}]. Ending.
            /endmacro
        }
        /varcalc i ${i}+1
        /if (${i}>${RCount}) /goto :cross
    }

    :nextpoint
        /varset wy ${RP[${i}].Arg[1]}
        /varset wx ${RP[${i}].Arg[2]}
        /moveto loc ${wy} ${wx}
        /varset t 30s
        :wait
            /if (${Zone.ID}!=${startZone}) /goto :arrived
            /delay 1
        /if (${Math.Distance[${wy},${wx}]}>12 && ${t}) /goto :wait
        /if (${Math.Distance[${wy},${wx}]}>12) {
            /moveto off
            /echo Stuck on route [${route}] at point ${i}. Ending.
            /endmacro
        }
        /varcalc i ${i}+1
    /if (${i}<=${RCount}) /goto :nextpoint

    :cross
    /moveto off
    /if (${RZoned}) {
        | keep running the way you were facing until the zone line takes us
        /face fast heading ${RHeading}
        /keypress forward hold
        /delay 20s ${Zone.ID}!=${startZone}
        /keypress forward
        /if (${Zone.ID}==${startZone}) {
            /echo Route [${route}] finished but I didn't zone. Ending.
            /endmacro
        }
    }
    :arrived
    /if (${RZoned}) /delay 5s
/return

| ---------------------------------------------------------
Sub GetAdventure
    /declare npcID int    local ${Spawn[npc ${QuestNPC}].ID}
    /declare i     int    local 1
    /declare nm    string local
    /declare tries int    local 0
    /declare avoided int  local 0
    /varset GotAdv FALSE
    /if (!${npcID}) {
        /echo Can't find ${QuestNPC}. Ending.
        /endmacro
    }
    /if (${HasCampSpot}) {
        | come in through the clear spot, then walk straight to the NPC
        /if (${Spawn[id ${npcID}].Distance}>80 && ${Navigation.MeshLoaded}) {
            /nav locyxz ${CampY} ${CampX} ${CampZ}
            /delay 1s
            /delay 5m !${Navigation.Active}
        }
        /moveto id ${npcID}
        /delay 1s
        /delay 30s ${MoveTo.Stopped}
    } else {
        /if (${Spawn[id ${npcID}].Distance}>15) {
            /nav id ${npcID}
            /delay 1s
            /delay 5m !${Navigation.Active}
        }
    }
    /if (${Spawn[id ${npcID}].Distance}>30) {
        /echo Couldn't get to ${QuestNPC}. Ending.
        /endmacro
    }
    /target id ${npcID}
    /delay 2s ${Target.ID}==${npcID}
    /face fast

    | NPCs ignore me while I'm invisible (Imitate Death, Fading Memories, ...)
    /call MakeVisible
    /click right target
    /delay 15s ${Window[AdventureRequestWnd].Open}
    | no answer: drop any invis that slipped through and try once more
    /if (!${Window[AdventureRequestWnd].Open}) {
        /call MakeVisible
        /click right target
        /delay 15s ${Window[AdventureRequestWnd].Open}
    }
    /if (!${Window[AdventureRequestWnd].Open}) {
        /echo Adventure window didn't open. Ending.
        /endmacro
    }
    | after a bail the old adventure is still mine, so leave it first
    | (the Decline button is "Leave" while I have one)
    /if (${Bailed}) {
        /delay 1s
        /if (${Window[AdventureRequestWnd].Child[AdvRqst_DeclineButton].Enabled}) {
            /echo Leaving the unfinished adventure.
            /notify AdventureRequestWnd AdvRqst_DeclineButton leftmouseup
            /delay 5s (${Window[ConfirmationDialogBox].Open} || ${Window[LargeDialogWindow].Open})
            /if (${Window[ConfirmationDialogBox].Open}) /notify ConfirmationDialogBox Yes_Button leftmouseup
            /if (${Window[LargeDialogWindow].Open}) /notify LargeDialogWindow LDW_YesButton leftmouseup
            /delay 3s
        }
        /varset Bailed FALSE
        /if (!${Window[AdventureRequestWnd].Open}) {
            /click right target
            /delay 15s ${Window[AdventureRequestWnd].Open}
        }
    }
    | wait for each dropdown to take before the next click (laggy zones)
    :setup
    /delay 1s
    /notify AdventureRequestWnd AdvRqst_RiskCombobox listselect ${RiskIndex}
    /delay 5s ${Window[AdventureRequestWnd].Child[AdvRqst_RiskCombobox].GetCurSel}==${RiskIndex}
    /notify AdventureRequestWnd AdvRqst_TypeCombobox listselect ${TypeIndex}
    /delay 5s ${Window[AdventureRequestWnd].Child[AdvRqst_TypeCombobox].GetCurSel}==${TypeIndex}
    /delay 5
    | The Accept button only lights up when the server offers an adventure.
    | On an error (already have one, not eligible, ...) the server puts the
    | reason in the window text and Accept stays greyed out, so retry a couple
    | of times and then give up instead of travelling without an adventure
    | (the main loop then tries the fallback camp).
    :request
    /varcalc tries ${tries}+1
    /notify AdventureRequestWnd AdvRqst_RequestButton leftmouseup
    /delay 20s ${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}
    /if (!${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}) {
        /echo Adventure request ${tries} of 3 was refused: ${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text}
        /if (${tries}<3) {
            /delay 5s
            /goto :request
        }
        /windowstate AdventureRequestWnd close
        /return
    }
    /delay 5
    | turn down an adventure in a dungeon on the avoid list and ask again
    /call CheckAvoid
    | (as many times as it takes: only a real request error counts as a try)
    /if (${AvoidHit.NotEqual[none]}) {
        /varcalc avoided ${avoided}+1
        /echo Offer ${avoided} is in ${AvoidHit}, which is on the avoid list. Declining it and asking again.
        /notify AdventureRequestWnd AdvRqst_DeclineButton leftmouseup
        /delay 5s !${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}
        /varcalc tries ${tries}-1
        | after Decline the window greys everything out, so close it and
        | talk to the recruiter again for a fresh one
        /delay 2s
        /windowstate AdventureRequestWnd close
        /delay 5s !${Window[AdventureRequestWnd].Open}
        /delay 1s
        /target id ${npcID}
        /delay 2s ${Target.ID}==${npcID}
        /call MakeVisible
        /click right target
        /delay 15s ${Window[AdventureRequestWnd].Open}
        /if (!${Window[AdventureRequestWnd].Open}) {
            /call MakeVisible
            /click right target
            /delay 15s ${Window[AdventureRequestWnd].Open}
        }
        /if (!${Window[AdventureRequestWnd].Open}) {
            /echo Adventure window didn't open again after declining. Ending.
            /endmacro
        }
        /goto :setup
    }

    | Which entrance does this adventure use?
    /varset UseEnt2 FALSE
    /if (${Ent2Names.NotEqual[none]}) {
        :names
        /varset nm ${Ent2Names.Arg[${i},|]}
        /if (${nm.Length} && ${nm.NotEqual[NULL]}) {
            /if (${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text.Find[${nm}]}) /varset UseEnt2 TRUE
            /varcalc i ${i}+1
            /goto :names
        }
    }
    /if (${UseEnt2}) /echo This adventure uses the second entrance.

    | Accept, and check it took: the button greys out (or the window closes)
    | once the adventure is ours
    /varset tries 0
    :accept
    /varcalc tries ${tries}+1
    /notify AdventureRequestWnd AdvRqst_AcceptButton leftmouseup
    /delay 5s (!${Window[AdventureRequestWnd].Open} || !${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled})
    /if (${Window[AdventureRequestWnd].Open} && ${Window[AdventureRequestWnd].Child[AdvRqst_AcceptButton].Enabled}) {
        /if (${tries}<2) /goto :accept
        /echo Accepted the adventure but the window didn't confirm it: ${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text} Ending.
        /endmacro
    }
    /echo Adventure accepted.
    /varset GotAdv TRUE
    /delay 2s
/return

| ---------------------------------------------------------
| From the landing zone back to the camp: run the return path, then use
| the Magus if this camp's trip back needs one
Sub ReturnToCamp
    /call TravelPath ${ReturnPath}
    /if (${RetMagusSay.NotEqual[none]} && ${Zone.ShortName.NotEqual[${CampZone}]}) /call UseMagus ret
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /echo Couldn't get back to ${CampZone} (I'm in ${Zone.ShortName}). Ending.
        /endmacro
    }
/return

| ---------------------------------------------------------
| Port by talking to a Magus
| which = out (camp -> entrance zone), ret (landing zone -> camp)
|         or to (any Magus -> this camp's zone)
Sub UseMagus(string which)
    /declare phrase    string local ${MagusSay}
    /declare mname     string local ${MagusName}
    /declare doExit    bool   local ${HasMagusExit}
    /declare exitY     float  local ${MagusExitY}
    /declare exitX     float  local ${MagusExitX}
    /if (${which.Equal[ret]}) {
        /varset phrase ${RetMagusSay}
        /varset mname  ${RetMagusName}
        /varset doExit ${HasRetExit}
        /varset exitY  ${RetExitY}
        /varset exitX  ${RetExitX}
    }
    | to = from wherever I am straight to this camp's zone; the arrival spot is
    | the same one the trip back uses
    /if (${which.Equal[to]}) {
        /varset phrase ${CampMagusSay}
        /varset mname  Magus
        /varset doExit ${HasRetExit}
        /varset exitY  ${RetExitY}
        /varset exitX  ${RetExitX}
    }
    /declare mid       int    local ${NearestSpawn[npc ${mname}].ID}
    /declare startZone string local ${Zone.ShortName}
    /declare t         timer  local 0
    | if the named Magus isn't here, use whichever Magus is closest
    /if (!${mid}) /varset mid ${NearestSpawn[npc Magus].ID}
    /if (!${mid}) {
        /echo No Magus found in ${Zone.ShortName}.
        /return
    }
    /if (${Spawn[id ${mid}].Distance}>15) {
        /nav id ${mid}
        /delay 1s
        /delay 3m !${Navigation.Active}
    }
    /target id ${mid}
    /delay 2s ${Target.ID}==${mid}
    /face fast
    /delay 5
    | NPCs ignore me while I'm invisible (Imitate Death, Fading Memories, ...)
    /call MakeVisible
    /say ${phrase}
    /delay 30s ${Zone.ShortName.NotEqual[${startZone}]}
    | no answer: drop any invis that slipped through and try once more
    /if (${Zone.ShortName.Equal[${startZone}]}) {
        /call MakeVisible
        /say ${phrase}
        /delay 30s ${Zone.ShortName.NotEqual[${startZone}]}
    }
    /delay 5s
    /if (${Zone.ShortName.Equal[${startZone}]}) {
        /echo The Magus didn't port me.
        /return
    }
    | walk straight out of the arrival camp before nav takes over
    /if (${doExit}) {
        /varset t 30s
        /moveto loc ${exitY} ${exitX}
        :wait
            /delay 2
        /if (${Math.Distance[${exitY},${exitX}]}>15 && ${t}) /goto :wait
        /moveto off
        /if (${Math.Distance[${exitY},${exitX}]}>15) /echo Didn't reach the clear spot after the port, carrying on from here.
    }
/return

| ---------------------------------------------------------
| Walk straight from the NPC to the clear spot outside the camp
Sub LeaveCamp
    /declare t timer local 30s
    /moveto loc ${CampY} ${CampX}
    :wait
        /delay 2
    /if (${Math.Distance[${CampY},${CampX}]}>15 && ${t}) /goto :wait
    /moveto off
    /if (${Math.Distance[${CampY},${CampX}]}>15) {
        /echo Couldn't reach the spot outside the camp. Ending.
        /endmacro
    }
/return

| ---------------------------------------------------------
Sub EnterDungeon
    /declare startZone string local ${Zone.ShortName}
    /declare tries     int    local 0
    /declare ez        string local ${Ent1Zone}
    /declare ey        float  local ${Ent1Y}
    /declare ex        float  local ${Ent1X}
    /declare ezz       string local ${Ent1Z}
    /declare edoor     int    local ${Ent1Door}
    /if (${UseEnt2}) {
        /varset edoor ${Ent2Door}
        /varset ez  ${Ent2Zone}
        /varset ey  ${Ent2Y}
        /varset ex  ${Ent2X}
        /varset ezz ${Ent2Z}
    }

    /if (${Zone.ShortName.NotEqual[${ez}]}) {
        /echo The entrance is in ${ez} but I'm in ${Zone.ShortName}. Ending.
        /endmacro
    }
    /if (!${Navigation.MeshLoaded}) {
        /echo No navmesh for ${Zone.ShortName}, can't get to the entrance. Ending.
        /endmacro
    }
    /if (${ezz.Equal[none]}) {
        /nav locyx ${ey} ${ex}
    } else {
        /nav locyxz ${ey} ${ex} ${ezz}
    }
    /delay 1s
    /delay 10m !${Navigation.Active}
    /if (${Math.Distance[${ey},${ex}]}>40) {
        /echo Couldn't reach the dungeon entrance. Ending.
        /endmacro
    }

    :clickloop
        | use the entrance's switch ID if the camp gives one, otherwise the nearest switch
        /if (${edoor}) {
            /doortarget id ${edoor}
        } else {
            /doortarget
        }
        /delay 5
        | walk up to the switch if it's out of click range
        /if (${DoorTarget.Distance}>15) {
            /moveto loc ${DoorTarget.Y} ${DoorTarget.X}
            /delay 10s ${DoorTarget.Distance}<15
            /moveto off
        }
        /face fast door
        /delay 3
        /click left door
        /delay 20s ${Zone.ShortName.NotEqual[${startZone}]}
        /varcalc tries ${tries}+1
    /if (${Zone.ShortName.Equal[${startZone}]} && ${tries}<3) /goto :clickloop

    /if (${Zone.ShortName.Equal[${startZone}]}) {
        /echo Couldn't enter the dungeon. Ending.
        /endmacro
    }
    /delay 5s
/return

| ---------------------------------------------------------
Sub ClearDungeon
    /declare clearTimer timer local ${MaxClearTime}
    /declare calm       int   local 0
    /declare fightTimer timer local 0
    /declare quiet      int   local 0
    /declare chasing    int   local 0
    /declare bailTimer  timer local ${BailMinutes}m
    /declare runTimer   timer local 10s
    /declare runSends   int   local 1
    /declare idleTimer  timer local 60s
    /varset AdvWon FALSE
    /varset Bailed FALSE
    /call DLog "clear start, sending ${PullerModeCmd} and ${PullerOnCmd}"
    /docommand ${PullerModeCmd}
    /delay 1s
    /docommand ${PullerOnCmd}

    /varset HitSeen FALSE
    :clearloop
        /call PumpEvents
        | Triune pauses itself when it handles the zone-in, and in a laggy zone
        | that can land after my run command. Send run again a few times early
        | on, and again whenever a minute goes by with no hits ("already
        | running" is harmless).
        /if (!${runTimer} && ${runSends}<4) {
            /docommand ${PullerOnCmd}
            /varcalc runSends ${runSends}+1
            /varset runTimer 10s
        }
        /if (!${idleTimer}) {
            /docommand ${PullerOnCmd}
            /varset idleTimer 60s
        }
        | with bail on, give up when nothing has been hit for BailMinutes
        /if (${HitSeen}) {
            /varset bailTimer ${BailMinutes}m
            /varset idleTimer 60s
            /varset HitSeen FALSE
        }
        /if (${BailOn} && !${bailTimer}) {
            /echo No hits for ${BailMinutes} minutes (stuck?), giving up on this adventure.
            /varset Bailed TRUE
        }
        /delay 1s
    /if (!${AdvWon} && !${Bailed} && ${clearTimer}) /goto :clearloop

    /if (!${AdvWon} && !${Bailed}) /echo Timed out without a win message, leaving anyway.
    /if (${AdvWon}) /echo Adventure complete, switching Triune to manual to finish what's on me.
    /call DLog "clear loop done: won=${AdvWon} bailed=${Bailed} timeLeft=${clearTimer}, sending ${PullerManualCmd}"

    | stop pulling, but keep fighting whatever is still on me
    /docommand ${PullerManualCmd}

    | wait until I've been out of combat for 5 seconds straight
    /varset fightTimer 10m
    | and if a fight goes quiet (no hits either way) for AggroDropAfter seconds,
    | drop aggro so a stuck mob doesn't block Bazaar and Back
    /varset HitSeen FALSE
    :fightloop
        /call PumpEvents
        | Triune should only be finishing what's on me now. If nothing is on my
        | extended target list and it's still running somewhere, it's still
        | pulling (the manual switch didn't take), so pause it.
        /if (!${Me.XTarget} && ${Navigation.Active}) {
            /varcalc chasing ${chasing}+1
            /if (${chasing}==5) {
                /echo Triune is still pulling after the adventure ended, pausing it.
                /call DLog "still pulling after the clear (nothing on XTarget, nav active), sending ${PullerOffCmd}"
                /docommand ${PullerOffCmd}
                /nav stop
            }
        } else {
            /varset chasing 0
        }
        /if (${Me.CombatState.Equal[COMBAT]}) {
            /varset calm 0
            /if (${HitSeen}) {
                /varset quiet 0
            } else {
                /varcalc quiet ${quiet}+1
            }
            /if (${quiet}>=${AggroDropAfter}) {
                /call DropAggro
                /varset quiet 0
            }
        } else {
            /varcalc calm ${calm}+1
            /varset quiet 0
        }
        /varset HitSeen FALSE
        /delay 1s
    /if (${calm}<5 && ${fightTimer}) /goto :fightloop
    /if (${calm}<5) {
        /echo Still in combat 10 minutes after the adventure ended. Ending here so I don't port out mid-fight.
        /call DLog "still in combat 10 minutes after the clear, ending"
        /endmacro
    }

    /call DLog "out of combat, sending ${PullerOffCmd}"
    /docommand ${PullerOffCmd}
    /delay 2s
/return

| ---------------------------------------------------------
| Set AvoidHit to the AvoidDungeons entry the offered adventure names (or none)
Sub CheckAvoid
    /declare i  int    local 1
    /declare nm string local
    /varset AvoidHit none
    :each
    /varset nm ${AvoidDungeons.Arg[${i},|]}
    /if (${nm.Length} && ${nm.NotEqual[NULL]}) {
        /if (${Window[AdventureRequestWnd].Child[AdvRqst_NPCText].Text.Find[${nm}]}) {
            /varset AvoidHit ${nm}
            /return
        }
        /varcalc i ${i}+1
        /goto :each
    }
/return

| ---------------------------------------------------------
| Drop invisibility so NPCs will talk to me
Sub MakeVisible
    /if (!${Me.Invis}) /return
    /echo Dropping invisibility so the NPC will answer.
    /makemevisible
    /delay 3s !${Me.Invis}
    /delay 5
/return

| ---------------------------------------------------------
| Use the first aggro drop in AggroDropList that I have and is ready
| (AAs like Fading Memories / Imitate Death, or a skill like Feign Death)
Sub DropAggro
    /declare i int    local 1
    /declare a string local
    :next
    /varset a ${AggroDropList.Arg[${i},|]}
    /if (${a.Length} && ${a.NotEqual[NULL]}) {
        /if (${Me.AltAbility[${a}]} && ${Me.AltAbilityReady[${a}]}) {
            /echo In combat with no hits for ${AggroDropAfter}s, using ${a} to drop aggro.
            /alt activate ${Me.AltAbility[${a}].ID}
            /goto :used
        }
        /if (${Me.Ability[${a}]} && ${Me.AbilityReady[${a}]}) {
            /echo In combat with no hits for ${AggroDropAfter}s, using ${a} to drop aggro.
            /doability "${a}"
            /goto :used
        }
        /varcalc i ${i}+1
        /goto :next
    }
    /echo In combat with no hits for ${AggroDropAfter}s, but none of these is ready: ${AggroDropList}
    /return
    :used
    /delay 5s ${Me.CombatState.NotEqual[COMBAT]}
    /delay 2s
    | feign death abilities leave me on the floor
    /if (${Me.Feigning}) /stand
/return

| ---------------------------------------------------------
Sub LeaveDungeon
    /declare startZone string local ${Zone.ShortName}

    | Bazaar AA
    /delay 3m ${Me.AltAbilityReady[${BazaarAAID}]}
    /alt activate ${BazaarAAID}
    /delay 60s (${Zone.ShortName.Equal[bazaar]} || ${Zone.ShortName.Equal[ecommons]} || ${Zone.ShortName.Equal[${LandZone}]})
    /delay 5s
    | Bazaar and Back can be set to East Commonlands; if it already put us in
    | this camp's landing zone, skip the walk to the map
    /if (${Zone.ShortName.Equal[${LandZone}]}) {
        /echo Bazaar and Back put me in ${LandZone}, skipping the map.
        /return
    }
    | otherwise use the map there (the Bazaar and East Commonlands both have one)
    /if (${Zone.ShortName.NotEqual[bazaar]} && ${Zone.ShortName.NotEqual[ecommons]}) {
        /echo Bazaar and Back didn't take me to the Bazaar, East Commonlands or ${LandZone}. Ending.
        /endmacro
    }
    /call MapPort
/return

| ---------------------------------------------------------
| In the Bazaar or East Commonlands: walk to the map and port to this camp's waypoint
Sub MapPort
    /declare row   int   local 0
    /declare tries int   local 0
    /declare my    float local ${MapY}
    /declare mx    float local ${MapX}
    /declare mz    float local ${MapZ}
    /declare startZone string local ${Zone.ShortName}
    | the map in East Commonlands is the same, just somewhere else
    /if (${Zone.ShortName.Equal[ecommons]}) {
        /varset my ${ECMapY}
        /varset mx ${ECMapX}
        /varset mz ${ECMapZ}
    }

    | Walk to the map. The landing spot is random, so try nav, and if it
    | can't start from here, step toward the map and try again.
    :mapwalk
    /if (${Math.Distance[${my},${mx}]}>15 && ${tries}<15) {
        /varcalc tries ${tries}+1
        /if (${Navigation.MeshLoaded}) {
            /nav locyxz ${my} ${mx} ${mz}
            /delay 1s
            /if (${Navigation.Active}) {
                /delay 3m !${Navigation.Active}
                /goto :mapwalk
            }
        }
        /moveto loc ${my} ${mx}
        /delay 4s ${Math.Distance[${my},${mx}]}<15
        /moveto off
        /goto :mapwalk
    }
    /if (${Math.Distance[${my},${mx}]}>25) {
        /echo Couldn't get to the map from here. Ending.
        /endmacro
    }

    | Click the map and pick this camp's waypoint. A full Bazaar can lag badly,
    | so wait for each window and list to be ready before the next click.
    /varset tries 0
    :mapclick
    /varcalc tries ${tries}+1
    /doortarget id ${MapSwitchID}
    /delay 5s ${DoorTarget.ID}==${MapSwitchID}
    /face fast door
    /delay 5
    /click left door
    /delay 15s ${Window[WaypointsWnd].Open}
    /if (!${Window[WaypointsWnd].Open} && ${tries}<3) /goto :mapclick
    /if (!${Window[WaypointsWnd].Open}) {
        /echo The map window didn't open. Ending.
        /endmacro
    }
    /delay 1s
    /notify WaypointsWnd ContinentsList listselect ${MapContinent}
    /delay 10s ${Window[WaypointsWnd].Child[ContinentsList].GetCurSel}==${MapContinent}
    /delay 10s ${Window[WaypointsWnd].Child[WaypointsList].Items}
    /delay 1s
    | a camp can give the row number directly; otherwise look the waypoint up by name
    /if (${MapRow}) {
        /varset row ${MapRow}
    } else {
        /delay 10s ${Window[WaypointsWnd].Child[WaypointsList].List[=${MapWaypoint}]}
        /varset row ${Window[WaypointsWnd].Child[WaypointsList].List[=${MapWaypoint}]}
    }
    /if (!${row}) {
        /echo Couldn't find ${MapWaypoint} in the waypoint list. Ending.
        /endmacro
    }
    /notify WaypointsWnd WaypointsList listselect ${row}
    /delay 5s ${Window[WaypointsWnd].Child[WaypointsList].GetCurSel}==${row}
    /delay 5
    /notify WaypointsWnd SelectedWaypointButton leftmouseup
    | wait for a confirmation box, or for the port itself
    /delay 10s (${Window[ConfirmationDialogBox].Open} || ${Window[LargeDialogWindow].Open} || ${Zone.ShortName.NotEqual[${startZone}]})
    /delay 5
    | answer a confirmation box if one pops up
    /if (${Window[ConfirmationDialogBox].Open}) /notify ConfirmationDialogBox Yes_Button leftmouseup
    /if (${Window[LargeDialogWindow].Open}) /notify LargeDialogWindow LDW_YesButton leftmouseup
    /delay 60s ${Zone.ShortName.Equal[${LandZone}]}
    /delay 5s

    /if (${Zone.ShortName.NotEqual[${LandZone}]}) {
        /echo Expected to land in ${LandZone} but I'm in ${Zone.ShortName}. Ending.
        /endmacro
    }
/return

| ---------------------------------------------------------
| Debug log: Logs\ldon.log in the MacroQuest folder, with the time
Sub DLog(string msg)
    /mqlog ${Time.Time24} run#${Runs} [${Camp}] ${Zone.ShortName}: ${msg}
/return

| ---------------------------------------------------------
| Handle the events that matter, then throw away the leftover hit lines.
| A plain /doevents only works through the queue one event at a time, so
| in a busy fight the hit lines piled up faster than they were handled
| and the "completed your adventure" line sat behind them, unseen.
Sub PumpEvents
    /doevents AdvWon
    /doevents AdvWon2
    /doevents AdvWon3
    /doevents AdvFail
    /doevents AdvFail2
    /doevents Slain
    /doevents AdvAny
    /doevents flush AdvAny
    /doevents HitOut
    /doevents HitIn
    /doevents MissIn
    /doevents flush HitOut
    /doevents flush HitIn
    /doevents flush MissIn
/return

Sub Event_AdvWon
    /varset AdvWon TRUE
    /call DLog "win message seen"
/return

Sub Event_AdvWon2
    /varset AdvWon TRUE
    /call DLog "win message seen (late completion)"
/return

Sub Event_AdvWon3
    /varset AdvWon TRUE
    /call DLog "win message seen (adventure was a success)"
/return

| a failed adventure is over too: stop clearing and head back like a win
Sub Event_AdvFail(string line)
    | "Complete your adventure goal within N minutes to receive a lesser
    | reward": still worth finishing, so keep clearing
    /if (${line.Find[lesser reward]}) {
        /call DLog "out of time, still clearing for the lesser reward"
        /return
    }
    /echo The adventure ran out of time with nothing left to win, leaving.
    /varset AdvWon TRUE
    /call DLog "adventure failed (out of time)"
/return

Sub Event_AdvFail2
    /echo The adventure failed, leaving.
    /varset AdvWon TRUE
    /call DLog "adventure failed"
/return

Sub Event_AdvAny(string line)
    /call DLog "chat: ${line}"
/return

Sub Event_HitOut
    /varset HitSeen TRUE
/return

Sub Event_HitIn
    /varset HitSeen TRUE
/return

Sub Event_MissIn
    /varset HitSeen TRUE
/return

Sub Event_Slain
    /echo Died on run #${Runs}. Ending.
    /endmacro
/return
