| ldon.mac - LDoN adventure loop for the Triune emu server
| Usage: /mac ldon <camp> [skip]
|   camp: sro (Deepest Guk)   ep (Miragul's)   bm (Mistmoore)
|         ec  (Rujarkian)     nro (Takish-Hiz)        default: sro
|   skip: already have an adventure and standing at the recruiter,
|         so don't request one on the first loop
| Start in the camp's zone. Every zone the loop passes through needs a navmesh.
| Zone crossings are built in (see Sub BuiltInRoute).

#turbo 40
#event AdvWon "#*#You have successfully completed your adventure#*#"
#event Slain  "#*#You have been slain#*#"

Sub Main(string a1, string a2)
    | ================= GENERAL CONFIG =================
    | Optional safety check: put a character name here and the macro will only
    | run on that character. Leave it empty to run on any character.
    /declare CharName     string outer

    | Adventure window dropdowns, counting from the top (1 = first entry)
    /declare RiskIndex    int    outer 2
    /declare TypeIndex    int    outer 3

    | Triune auto combat puller
    /declare PullerModeCmd   string outer /ac puller
    /declare PullerOnCmd     string outer /ac run
    | stops chasing new mobs but keeps fighting what's already on me
    /declare PullerManualCmd string outer /ac manual
    | only sent once combat is completely over
    /declare PullerOffCmd    string outer /ac stop
    /declare MaxClearTime string outer 90m

    | "Bazaar and Back" AA, and the map switch in the Bazaar
    /declare BazaarAAID   int    outer 331
    /declare MapY         float  outer -646.5
    /declare MapX         float  outer 2.9
    /declare MapZ         float  outer 4.8
    /declare MapSwitchID  int    outer 146
    | ==================================================

    | Per-camp settings, filled in by SetCamp below
    /declare CampZone     string outer
    /declare QuestNPC     string outer
    /declare HasCampSpot  bool   outer FALSE
    /declare CampY        float  outer 0
    /declare CampX        float  outer 0
    /declare CampZ        float  outer 0
    /declare Ent1Zone     string outer
    /declare Ent1Path     string outer none
    /declare Ent1Y        float  outer 0
    /declare Ent1X        float  outer 0
    /declare Ent1Z        string outer none
    /declare Ent1Door     int    outer 0
    /declare MagusSay     string outer none
    /declare MagusName    string outer Magus
    /declare HasMagusExit bool   outer FALSE
    /declare MagusExitY   float  outer 0
    /declare MagusExitX   float  outer 0
    /declare Ent2Names    string outer none
    /declare Ent2Zone     string outer
    /declare Ent2Path     string outer none
    /declare Ent2Y        float  outer 0
    /declare Ent2X        float  outer 0
    /declare Ent2Z        string outer none
    /declare Ent2Door     int    outer 0
    /declare MapContinent int    outer 0
    /declare MapWaypoint  string outer none
    /declare MapRow       int    outer 0
    /declare LandZone     string outer
    /declare ReturnPath   string outer none
    /declare RetMagusSay  string outer none
    /declare RetMagusName string outer Magus
    /declare HasRetExit   bool   outer FALSE
    /declare RetExitY     float  outer 0
    /declare RetExitX     float  outer 0

    | Route data, filled in by LoadRoute
    /declare PathFile string outer ldon_paths.ini
    /declare RP[300]  string outer
    /declare RCount   int    outer 0
    /declare RZoned   int    outer 0
    /declare RZone    string outer none
    /declare RHeading float  outer 0
    /declare RLastZ   string outer NONE
    /declare RBuiltIn bool   outer FALSE
    /declare Camp     string outer sro
    /declare SkipGet  bool   outer FALSE
    /declare UseEnt2  bool   outer FALSE
    /declare AdvWon   bool   outer FALSE
    /declare Missing  int    outer 0
    /declare Runs     int    outer 0

    | a missing argument can arrive as an empty value, so only use real ones
    /if (${Defined[a1]}) {
        /if (${a1.Length} && ${a1.NotEqual[NULL]}) /call ParseArg ${a1}
    }
    /if (${Defined[a2]}) {
        /if (${a2.Length} && ${a2.NotEqual[NULL]}) /call ParseArg ${a2}
    }
    /call SetCamp

    | ---------- startup checks ----------
    /if (${CharName.Length}) {
        /if (${Me.Name.NotEqual[${CharName}]}) {
            /echo This macro is set up for ${CharName}. Ending.
            /endmacro
        }
    }
    /if (${MapWaypoint.Equal[none]}) {
        /echo The return trip for camp [${Camp}] isn't set up yet (map waypoint, landing zone, path back). Ending.
        /endmacro
    }
    | with a Magus shortcut the run to the entrance is only a fallback, so don't require its routes
    /if (${MagusSay.Equal[none]}) /call CheckPath ${CampZone} ${Ent1Path}
    /if (${Ent2Names.NotEqual[none]}) /call CheckPath ${CampZone} ${Ent2Path}
    /call CheckPath ${LandZone} ${ReturnPath}
    /if (${Missing}) {
        /echo ${Missing} zone crossing(s) missing for camp [${Camp}]. Ending.
        /endmacro
    }
    /echo Running camp [${Camp}] with recruiter ${QuestNPC}.

    | ---------- where am I starting? ----------
    /if (${Zone.ShortName.Equal[bazaar]}) {
        /echo Starting in the Bazaar: taking the map and heading to camp.
        /call MapPort
        /call ReturnToCamp
    }
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /if (${Zone.ShortName.Equal[${LandZone}]} || ${ReturnPath.Find[${Zone.ShortName}]}) {
            /echo Starting in ${Zone.ShortName}: heading to camp.
            /call ReturnToCamp
        }
    }
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /echo Starting in ${Zone.ShortName}: going to the Bazaar, then to camp.
        /call LeaveDungeon
        /call ReturnToCamp
    }
    /if (${Zone.ShortName.NotEqual[${CampZone}]}) {
        /echo Couldn't get to ${CampZone} (I'm in ${Zone.ShortName}). Ending.
        /endmacro
    }

    :mainloop
        /if (${SkipGet}) {
            /echo Skipping the adventure request for this loop (assuming the first entrance).
            /varset UseEnt2 FALSE
        } else {
            /call GetAdventure
        }
        /varset SkipGet FALSE
        /if (${HasCampSpot}) /call LeaveCamp
        /if (${UseEnt2}) {
            /call TravelPath ${Ent2Path}
        } else {
            /if (${MagusSay.NotEqual[none]}) /call UseMagus out
            | does nothing if the Magus already put us in the entrance zone
            /call TravelPath ${Ent1Path}
        }
        /call EnterDungeon
        /call ClearDungeon
        /call LeaveDungeon
        /call ReturnToCamp
        /varcalc Runs ${Runs}+1
        /echo Finished run #${Runs}
    /goto :mainloop
/return

| ---------------------------------------------------------
Sub ParseArg(string a)
    /if (!${Defined[a]}) /return
    /if (!${a.Length} || ${a.Equal[NULL]}) /return
    /if (${a.Equal[skip]}) {
        /varset SkipGet TRUE
    } else {
        /varset Camp ${a}
    }
/return

| ---------------------------------------------------------
| ================= PER-CAMP CONFIG =================
| Paths are zone short names in travel order, separated by |  (none = same zone)
| Ent2 is only used when the adventure text contains one of the words or
| phrases in Ent2Names (separated by |, upper/lower case doesn't matter).
| MapRow, if set, picks the waypoint by its position in the list instead of by name.
| MagusSay, if set, is said to the camp's Magus to port to the first entrance's zone.
| RetMagusSay, if set, is said to the Magus in the landing zone to port to the camp.
| An entrance Z of none means "let nav work out the height".
| An entrance Door is the switch ID to click (0 = nearest switch).
Sub SetCamp
    /if (${Camp.Equal[sro]}) {
        | Deepest Guk
        /varset CampZone     sro
        /varset QuestNPC     Kallei Ribblok
        /varset HasCampSpot  TRUE
        /varset CampY        -1497.2
        /varset CampX        998.3
        /varset CampZ        -23.2
        /varset Ent1Zone     guktop
        /varset Ent1Path     innothule|guktop
        /varset Ent1Y        438.1
        /varset Ent1X        224.2
        /varset Ent1Z        -9.2
        /varset Ent2Names    Cauldron of Lost Souls
        /varset Ent2Zone     innothule
        /varset Ent2Path     innothule
        /varset Ent2Y        1353
        /varset Ent2X        1186
        | Trip back: East Commonlands waypoint, then the Magus there ports to this camp
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset RetMagusSay  South Ro
        /varset RetMagusName Magus Zeir
        | after the port, walk straight to this clear spot first (tents)
        /varset HasRetExit   TRUE
        /varset RetExitY     -1458.2
        /varset RetExitX     1069.9
        | Old trip back, running from Grobb. To use it, put a | in front of the
        | nine lines above and remove the | from the four lines below.
        |/varset MapContinent 1
        |/varset MapWaypoint  Grobb
        |/varset LandZone     grobb
        |/varset ReturnPath   innothule|sro
        /return
    }
    /if (${Camp.Equal[ep]}) {
        | Miragul's Menagerie - both entrances are in Everfrost itself
        /varset CampZone     everfrost
        /varset QuestNPC     Mannis McGuyett
        /varset Ent1Zone     everfrost
        /varset Ent1Y        -828
        /varset Ent1X        -5458
        /varset Ent2Names    Hushed Banquet|Heart of the Menagerie
        /varset Ent2Zone     everfrost
        /varset Ent2Y        2771
        /varset Ent2X        -4725
        | Trip back: East Commonlands waypoint, then the Magus there ports to this camp
        | (faster than the Everfrost waypoint and running).
        | GUESS - confirm "Everfrost" is the phrase Magus Zeir answers to
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset RetMagusSay  Everfrost
        /varset RetMagusName Magus Zeir
        | Old trip back, the Everfrost waypoint. To use it, put a | in front of the
        | five lines above and remove the | from the three lines below.
        |/varset MapWaypoint  Everfrost
        |/varset LandZone     everfrost
        |/varset RetMagusSay  none
        /return
    }
    /if (${Camp.Equal[bm]}) {
        | Mistmoore's Catacombs - entrances are in Lesser Faydark
        /varset CampZone     butcher
        /varset QuestNPC     Xyzelauna
        /varset Ent1Zone     lfaydark
        /varset Ent1Path     gfaydark|lfaydark
        /varset Ent1Y        -759.1
        /varset Ent1X        3832.8
        /varset Ent1Z        2.5
        /varset Ent1Door     7
        | Ent1 (switch 7) is the crypt entrance, Ent2 (switch 10) is the grave entrance.
        | The adventure text says which one to use.
        /varset Ent2Names    grave
        /varset Ent2Zone     lfaydark
        /varset Ent2Path     gfaydark|lfaydark
        /varset Ent2Y        -111.0
        /varset Ent2X        3861.8
        /varset Ent2Z        -39.6
        /varset Ent2Door     10
        | Trip back: East Commonlands waypoint, then the Magus there ports to this camp
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset RetMagusSay  Butcherblock
        /varset RetMagusName Magus Zeir
        /return
    }
    /if (${Camp.Equal[ec]}) {
        | Rujarkian Hills - entrance is in South Ro
        /varset CampZone     ecommons
        /varset QuestNPC     Periac Windfell
        /varset Ent1Zone     sro
        /varset Ent1Path     nro|oasis|sro
        | Shortcut: say this to the Magus at the camp to port to the entrance zone.
        | To go back to running Ent1Path, put a | at the start of the next line.
        /varset MagusSay     South Ro
        /varset MagusName    Magus Zeir
        | after the port, walk straight to this clear spot before using nav (tents)
        /varset HasMagusExit TRUE
        /varset MagusExitY   -1458.2
        /varset MagusExitX   1069.9
        /varset Ent1Y        -2111.9
        /varset Ent1X        1331.6
        /varset Ent1Z        -68.3
        | switch 1 = RUJPORTAL701 (switch 6, HUT1, is just a hut next to it)
        /varset Ent1Door     1
        | Antonica, the "East Commonlands" waypoint (found by name)
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /return
    }
    /if (${Camp.Equal[nro]}) {
        | Takish-Hiz - entrance is in North Ro itself
        /varset CampZone     nro
        /varset QuestNPC     Escon Quickbow
        /varset Ent1Zone     nro
        /varset Ent1Y        -956.2
        /varset Ent1X        119.7
        /varset Ent1Z        -61.4
        /varset Ent1Door     3
        | Trip back: East Commonlands waypoint, then the Magus there ports to this camp
        /varset MapContinent 1
        /varset MapWaypoint  East Commonlands
        /varset LandZone     ecommons
        /varset RetMagusSay  North Ro
        /varset RetMagusName Magus Zeir
        /return
    }
    /echo Unknown camp [${Camp}]. Use one of: sro ep bm ec nro
    /endmacro
/return

| ---------------------------------------------------------
| Report any zone crossing on this path that hasn't been recorded
Sub CheckPath(string fromZone, string path)
    /if (${path.Equal[none]}) /return
    /declare i    int    local 1
    /declare prev string local ${fromZone}
    /declare z    string local
    :hop
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /call LoadRoute ${prev}_to_${z}
        /if (${RCount}<2) {
            /echo Missing zone crossing: ${prev}_to_${z} is not built in (see Sub BuiltInRoute).
            /varcalc Missing ${Missing}+1
        }
        /varset prev ${z}
        /varcalc i ${i}+1
        /goto :hop
    }
/return

| ---------------------------------------------------------
| Travel through a list of zones, one crossing at a time
Sub TravelPath(string path)
    /if (${path.Equal[none]}) /return
    /declare i     int    local 1
    /declare first int    local 1
    /declare z     string local

    | if I'm already in one of the zones on the path, continue from there
    :find
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /if (${Zone.ShortName.Equal[${z}]}) /varcalc first ${i}+1
        /varcalc i ${i}+1
        /goto :find
    }

    /varset i ${first}
    :hop
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /call RunRoute ${Zone.ShortName}_to_${z}
        /varcalc i ${i}+1
        /goto :hop
    }
/return
    /declare i int    local 1
    /declare z string local
    :hop
    /varset z ${path.Arg[${i},|]}
    /if (${z.Length} && ${z.NotEqual[NULL]}) {
        /if (${Zone.ShortName.NotEqual[${z}]}) /call RunRoute ${Zone.ShortName}_to_${z}
        /varcalc i ${i}+1
        /goto :hop
    }
/return

| ---------------------------------------------------------
| Load a route into RP[] / RCount / RZone / RZoned / RHeading / RLastZ.
| Built-in routes come first; anything else is read from ldon_paths.ini if present.
Sub LoadRoute(string route)
    /declare i int local 1
    /varset RCount   0
    /varset RBuiltIn FALSE
    /call BuiltInRoute ${route}
    /if (${RCount}) /return

    /varset RCount   ${Ini[${PathFile},${route},Count,0]}
    /if (${RCount}>300) /varset RCount 300
    /varset RZoned   ${Ini[${PathFile},${route},Zoned,0]}
    /varset RZone    ${Ini[${PathFile},${route},Zone,none]}
    /varset RHeading ${Ini[${PathFile},${route},Heading,0]}
    /varset RLastZ   ${Ini[${PathFile},${route},LastZ,NONE]}
    :load
    /if (${i}<=${RCount}) {
        /varset RP[${i}] ${Ini[${PathFile},${route},${i}]}
        /varcalc i ${i}+1
        /goto :load
    }
/return

| ---------------------------------------------------------
| ================= BUILT-IN ZONE CROSSINGS =================
| Taken from recorded runs: the last few points before the
| zone line, the height there, and the heading used to run across.
| To change one, edit its points, height and heading here.
Sub BuiltInRoute(string route)
    /if (${route.Equal[sro_to_innothule]}) {
        /varset RZone    sro
        /varset RZoned   1
        /varset RHeading 114.95
        /varset RLastZ   -23.05
        /varset RCount   6
        /varset RP[1] -3105.89 1089.84
        /varset RP[2] -3134.52 1059.16
        /varset RP[3] -3174.04 1043.41
        /varset RP[4] -3204.04 1070.45
        /varset RP[5] -3197.69 1113.27
        /varset RP[6] -3200.11 1134.10
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[innothule_to_guktop]}) {
        /varset RZone    innothule
        /varset RZoned   1
        /varset RHeading 235.41
        /varset RLastZ   -7.73
        /varset RCount   4
        /varset RP[1] 185.05 -714.98
        /varset RP[2] 176.92 -755.63
        /varset RP[3] 170.92 -797.48
        /varset RP[4] 138.19 -828.50
        /varset RBuiltIn TRUE
        /return
    }
    /if (${route.Equal[grobb_to_innothule]}) {
